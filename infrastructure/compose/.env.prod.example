# ============================================================================
# SPP Valora AI — variáveis de produção (EXEMPLO)
#
# Copie para `.env` e substitua TODOS os valores. NÃO versione o `.env` real.
#   cp .env.prod.example .env
#
# Gere senhas fortes, ex.:  openssl rand -base64 24
# ============================================================================

# --- Banco de dados (Postgres) ---
POSTGRES_DB=spp_valora
POSTGRES_USER=spp
POSTGRES_PASSWORD=TROQUE_esta_senha_do_postgres

# --- Redis ---
REDIS_PASSWORD=TROQUE_esta_senha_do_redis

# --- Origem pública do app (usada em CORS) ---
# Domínio/host por onde o navegador acessa o nginx. Ex.: https://valora.suaempresa.com.br
# Em teste direto por IP:  http://SEU_IP_PUBLICO
PUBLIC_ORIGIN=http://localhost
